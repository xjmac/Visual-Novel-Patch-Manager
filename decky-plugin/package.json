{
  "name": "decky-vnpm",
  "version": "0.2.0",
  "description": "Visual Novel Patch Manager integration for Steam Deck Game Mode via Decky Loader",
  "author": "VNPM Contributors",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "python3 scripts/write-vn-library.py && rollup -c",
    "watch": "python3 scripts/write-vn-library.py && rollup -c -w"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
